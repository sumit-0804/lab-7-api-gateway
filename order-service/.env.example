# Copy to .env to run this service on the host without Docker. Never commit .env.
PORT=3003
# Lab 7: MongoDB Atlas, one database per service (the name after the host).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/orderdb?retryWrites=true&w=majority

# Host (no Docker): the other services are reachable on localhost.
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002

# Inside Docker the host is the service name, not localhost:
# USER_SERVICE_URL=http://user-service:3001
# PRODUCT_SERVICE_URL=http://product-service:3002

# Inter-service call behaviour.
DEPENDENCY_TIMEOUT_MS=3000
DEPENDENCY_RETRIES=1
DEPENDENCY_RETRY_DELAY_MS=300
