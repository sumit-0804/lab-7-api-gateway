{
  "info": {
    "name": "API Gateway - Lab 7",
    "description": "Every request goes to ONE address: {{baseUrl}}, the API Gateway.\nSelect the environment \"Lab7 - Local\" (http://localhost:8080) or \"Lab7 - Cloud\" (public gateway URL) and run the same collection against both.\n\nFolders 1-5 run automatically in order (Collection Runner / newman).\nFolder 6 is manual: stop a service (locally `docker compose stop user-service`, in the cloud suspend the service), send 6a and 6b, restart it, send 6c. While the service is up, 6a/6b report themselves as skipped instead of failing.\n\nEmails and SKUs are generated per run, so the collection can be run repeatedly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Gateway",
      "item": [
        {
          "name": "01 GET /health (gateway itself)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('answered by the gateway, not proxied', () => pm.expect(body.service).to.eql('api-gateway'));",
                  "pm.test('three routes registered', () => pm.expect(body.routes.map(r => r.prefix)).to.eql(['/users', '/products', '/orders']));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 GET /health/services (registry check)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/services",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "services"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK - every registered service answered', () => pm.response.to.have.status(200));",
                  "const names = pm.response.json().services.map(s => s.service);",
                  "pm.test('checks all three services', () => pm.expect(names).to.eql(['user-service', 'product-service', 'order-service']));",
                  "pm.test('each service has a connected database', () => pm.response.json().services.forEach(s => pm.expect(s.health.db).to.eql('connected')));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 GET /unknown -> 404 from gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/unknown",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "unknown"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('answered by the gateway', () => pm.expect(pm.response.json().service).to.eql('api-gateway'));"
                ]
              }
            }
          ]
        }
      ]
    },
