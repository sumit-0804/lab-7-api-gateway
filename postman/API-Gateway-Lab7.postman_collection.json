          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('userId') || !pm.variables.get('productId')) {",
                  "    throw new Error('{{userId}} / {{productId}} not set - run the earlier folders first.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.test('Order -> User call succeeded', () => pm.expect(body.userSnapshot.email).to.eql(pm.variables.get('userEmail')));",
                  "    pm.test('Order -> Product call succeeded', () => pm.expect(body.productSnapshot.sku).to.eql(pm.variables.get('productSku')));",
                  "    pm.test('price came from product-service', () => pm.expect(body.totalPrice).to.eql(body.unitPrice * body.quantity));",
                  "    pm.collectionVariables.set('orderId', body.id);",
                  "} else {",
                  "    pm.collectionVariables.set('orderId', '');",
                  "}"
                ]
              }
            }
          ]
