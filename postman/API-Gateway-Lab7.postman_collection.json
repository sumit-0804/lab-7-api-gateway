    {
      "name": "6. Unreachable service (manual)",
      "description": "Stop user-service first (local: `docker compose stop user-service`). Send 6a and 6b. Then start it again (`docker compose start user-service`) and send 6c.",
      "item": [
        {
          "name": "6a GET /users with user-service stopped -> 503 from gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test.skip('Skipped: user-service is still up. Stop it, then send this request again.');",
                  "} else {",
                  "    const body = pm.response.json();",
                  "    pm.test('503 Service Unavailable', () => pm.response.to.have.status(503));",
                  "    pm.test('answered by the gateway, not a hang or crash', () => pm.expect(body.service).to.eql('api-gateway'));",
                  "    pm.test('names the unreachable service', () => pm.expect(body.target).to.eql('user-service'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6b POST /orders with user-service stopped -> 503 from order-service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('userId') || !pm.variables.get('productId')) {",
                  "    throw new Error('{{userId}} / {{productId}} not set - run the earlier folders first.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.test.skip('Skipped: user-service is still up. Stop it, then send this request again.');",
                  "} else {",
                  "    const body = pm.response.json();",
                  "    pm.test('503 Service Unavailable', () => pm.response.to.have.status(503));",
                  "    pm.test('order-service (behind the gateway) names the failing dependency', () => pm.expect(body.dependency).to.eql('user-service'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6c GET /users after restart -> 200 (recovery)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 503) {",
                  "    pm.test.skip('Skipped: user-service is still stopped. Start it, wait a few seconds, send again.');",
                  "} else {",
                  "    pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
