# Copy to .env to run the gateway on the host without Docker. Never commit .env.
# Under Docker these come from compose.yaml; in the cloud, from the platform's env settings.
PORT=8080

# Service registry: where each backend lives. Change these, not the code.
# Host (no Docker):
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003

# Inside Docker the host is the Compose service name:
# USER_SERVICE_URL=http://user-service:3001

# How long to wait for a backend before answering 503.
PROXY_TIMEOUT_MS=10000
