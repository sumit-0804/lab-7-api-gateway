# Copy to .env next to compose.yaml. Docker Compose reads it automatically.
# .env holds your Atlas password: never commit it (it is in .gitignore).

# --- Public port -----------------------------------------------------------
# The only port published on the host.
GATEWAY_PORT=8080

# --- Service registry (service discovery) ----------------------------------
# The gateway and Order Service find the other services only through these.
# To move a service, change its port and its URL here - no code change.
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003

USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# --- MongoDB Atlas ---------------------------------------------------------
# One cluster, one database per service (the name after the host).
USER_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/userdb?retryWrites=true&w=majority
PRODUCT_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/productdb?retryWrites=true&w=majority
ORDER_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/orderdb?retryWrites=true&w=majority

# --- Timeouts --------------------------------------------------------------
PROXY_TIMEOUT_MS=10000
DEPENDENCY_TIMEOUT_MS=3000
DEPENDENCY_RETRIES=1
